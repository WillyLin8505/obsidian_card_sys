CLAUDE_API_KEY=sk-ant-your-key-here
PORT=3001
HOST=127.0.0.1
LOCAL_SERVER_TOKEN=replace-with-a-long-random-local-server-token
NOTEBOOKLM_API_URL=http://127.0.0.1:3000
NOTEBOOKLM_NOTEBOOK_URL=
OBSIDIAN_VAULT_PATHS=/mnt/d/obsidian/Willy_2026

# Full Card Box App → Cloudflare Tunnel
# Tunnel only APP_GATEWAY_PORT. Do not expose local-server :3001 or NotebookLM MCP :3000.
APP_GATEWAY_TOKEN=replace-with-a-long-random-app-token
APP_GATEWAY_HOST=127.0.0.1
APP_GATEWAY_PORT=3020
APP_GATEWAY_FRONTEND_ORIGIN=http://127.0.0.1:5173
APP_GATEWAY_INTERNAL_API_URL=http://127.0.0.1:3001

# Search server process. Set AUTO_START_SEARCH_SERVER=false when search_server.py
# is managed separately.
AUTO_START_SEARCH_SERVER=true
SEARCH_SERVER_PYTHON=../llama-search/.venv-wsl/bin/python
SEARCH_SERVER_SCRIPT=../llama-search/search_server.py
SEARCH_SERVER_CWD=../llama-search

# ASR (語音辨識) provider: funasr | openai | groq
# funasr = 本地 paraformer-zh（預設，免費）
# openai = OpenAI Whisper API（$0.006/min，需 OPENAI_API_KEY）
# groq   = Groq Whisper Large v3（免費，需 GROQ_API_KEY）
ASR_PROVIDER=funasr
OPENAI_API_KEY=
GROQ_API_KEY=

# iOS Share Sheet → Cloudflare Tunnel → 文獻筆記
IOS_SHARE_TOKEN=replace-with-a-long-random-token
IOS_SHARE_GATEWAY_HOST=127.0.0.1
IOS_SHARE_GATEWAY_PORT=3010
IOS_SHARE_INTERNAL_API_URL=http://127.0.0.1:3001
IOS_SHARE_SOURCE_NOTE_DIR=Sources/inbox
IOS_SHARE_ANALYZE_TIMEOUT_MS=240000
IOS_SHARE_GATEWAY_TIMEOUT_MS=260000
